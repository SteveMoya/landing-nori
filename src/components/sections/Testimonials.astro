---
import { testimonials } from '../../data/testimonials';
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';
---

<Section id="opiniones" ariaLabelledBy="testimonials-title">
  <div class="mb-14 max-w-2xl">
    <p class="mb-3 font-display text-sm font-bold uppercase tracking-widest text-lavanda-deep">Opiniones</p>
    <h2
      id="testimonials-title"
      class="font-display text-4xl font-bold tracking-tight sm:text-5xl"
    >
      Lo que dicen <span class="text-lavanda-deep">quienes ya trabajaron con nosotros</span>
    </h2>
  </div>

  <ul class="grid gap-6 md:grid-cols-3">
    {
      testimonials.map((testimonial, index) => (
        <li data-reveal style={`--reveal-delay:${index * 90}ms`}>
          <Card tone="white" class="flex h-full flex-col">
            <div class="flex gap-1 text-butter" role="img" aria-label="Valoración: 5 de 5 estrellas">
              {Array.from({ length: 5 }).map(() => <Icon name="star" size={14} />)}
            </div>
            <blockquote class="mt-4 flex-1 text-[15px] leading-relaxed text-ink/80">
              “{testimonial.quote}”
            </blockquote>
            <figcaption class="mt-6 flex items-center gap-3 border-t border-ink/10 pt-4">
              <span class="grid h-10 w-10 shrink-0 place-items-center rounded-full bg-lavanda font-display text-sm font-bold">
                {testimonial.initials}
              </span>
              <div>
                <p class="font-display text-sm font-bold">{testimonial.name}</p>
                <p class="text-xs text-ink/55">{testimonial.role}</p>
              </div>
            </figcaption>
          </Card>
        </li>
      ))
    }
  </ul>
</Section>

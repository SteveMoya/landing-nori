---
import { faqs } from '../../data/faqs';
import Section from '../ui/Section.astro';
import Icon from '../ui/Icon.astro';
---

<Section id="preguntas" ariaLabelledBy="faq-title" background="white">
  <div class="mb-14 max-w-2xl">
    <p class="mb-3 font-display text-sm font-bold uppercase tracking-widest text-lavanda-deep">Preguntas frecuentes</p>
    <h2
      id="faq-title"
      class="font-display text-4xl font-bold tracking-tight sm:text-5xl"
    >
      Resolvemos tus dudas <span class="text-lavanda-deep">antes de empezar</span>
    </h2>
  </div>

  <div
    class="mx-auto max-w-3xl space-y-3"
    x-data="{ openItem: null }"
  >
    {
      faqs.map((faq, index) => (
        <div class="overflow-hidden rounded-2xl border border-ink/10 bg-cream transition-colors" :class={`openItem === ${index} ? 'border-lavanda-deep/40' : ''`}>
          <button
            type="button"
            class="flex w-full items-center justify-between gap-4 px-6 py-5 text-left font-display text-base font-semibold"
            :aria-expanded={`openItem === ${index}`}
            aria-controls={`faq-panel-${index}`}
            @click={`openItem = openItem === ${index} ? null : ${index}`}
          >
            {faq.question}
            <span
              class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-white text-ink/60 ring-1 ring-ink/10 transition-transform duration-300"
              :class={`openItem === ${index} ? 'rotate-45' : ''`}
            >
              <Icon name="plus" size={15} />
            </span>
          </button>
          <div
            id={`faq-panel-${index}`}
            x-show={`openItem === ${index}`}
            x-collapse
            x-cloak
          >
            <p class="px-6 pb-6 text-sm leading-relaxed text-ink/65">{faq.answer}</p>
          </div>
        </div>
      ))
    }
  </div>
</Section>

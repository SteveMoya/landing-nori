---
import { services } from '../../data/services';
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import Icon from '../ui/Icon.astro';
---

<Section id="servicios" ariaLabelledBy="services-title">
  <div class="mb-14 max-w-2xl">
    <p class="mb-3 font-display text-sm font-bold uppercase tracking-widest text-lavanda-deep">Servicios</p>
    <h2
      id="services-title"
      class="font-display text-4xl font-bold tracking-tight sm:text-5xl"
    >
      Todo lo que tu web necesita, <span class="text-lavanda-deep">en un solo equipo</span>
    </h2>
  </div>

  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      services.map((service, index) => (
        <li
          data-reveal
          style={`--reveal-delay:${(index % 3) * 80}ms`}
          class:list={[index === 0 && 'sm:col-span-2 lg:col-span-1']}
        >
          <Card tone={service.tone} class="group h-full">
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-white/70 shadow-soft transition-transform duration-200 group-hover:-rotate-6">
              <Icon name={service.icon} size={22} />
            </span>
            <h3 class="mt-5 font-display text-xl font-bold tracking-tight">{service.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink/65">{service.description}</p>
          </Card>
        </li>
      ))
    }
  </ul>
</Section>

---
import { site } from '../../data/site';
import Logo from '../brand/Logo.astro';
import Icon from '../ui/Icon.astro';
---

<footer class="border-t border-ink/10 bg-white">
  <div class="container-nori py-16">
    <div class="grid gap-12 md:grid-cols-2 lg:grid-cols-4">
      <div class="flex flex-col gap-5">
        <Logo />
        <p class="max-w-xs text-sm leading-relaxed text-ink/60">
          {site.description}
        </p>
        <div class="flex gap-3">
          {
            site.socials.map((s) => (
              <a
                href={s.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={s.name}
                class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-cream text-ink ring-1 ring-ink/10 transition-all duration-200 hover:-translate-y-0.5 hover:text-lavanda-deep"
              >
                <Icon name={s.icon} size={17} />
              </a>
            ))
          }
        </div>
      </div>

      <nav aria-label="Explorar">
        <h3 class="mb-4 font-display text-sm font-bold text-ink">Explorar</h3>
        <ul class="space-y-3">
          {
            site.nav.map((item) => (
              <li>
                <a href={item.href} class="text-sm text-ink/60 transition-colors hover:text-lavanda-deep">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex flex-col gap-4">
        <h3 class="font-display text-sm font-bold text-ink">Contacto</h3>
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-2 text-sm text-ink/60 transition-colors hover:text-lavanda-deep"
        >
          <Icon name="mail" size={16} class="text-lavanda-deep" />
          {site.email}
        </a>
        <p class="max-w-[220px] text-xs leading-relaxed text-ink/50">
          Respondemos en menos de 24 horas, de lunes a viernes.
        </p>
      </div>

      <div>
        <h3 class="mb-4 font-display text-sm font-bold text-ink">¿Hablamos?</h3>
        <a
          href={`mailto:${site.email}?subject=Proyecto%20nuevo`}
          class="inline-flex items-center gap-2 rounded-full bg-lavanda px-5 py-3 font-display text-sm font-semibold text-ink shadow-soft transition-all duration-200 hover:-translate-y-0.5 hover:shadow-pastel"
        >
          Empezar un proyecto
          <Icon name="arrow-right" size={15} />
        </a>
      </div>
    </div>

    <div class="mt-14 flex flex-col items-center justify-between gap-4 border-t border-ink/10 pt-8 text-xs text-ink/50 sm:flex-row">
      <p>© {new Date().getFullYear()} {site.name}. Todos los derechos reservados.</p>
      <div class="flex gap-6">
        <a href={site.legal.privacy} class="transition-colors hover:text-lavanda-deep">Aviso de privacidad</a>
        <a href={site.legal.terms} class="transition-colors hover:text-lavanda-deep">Términos</a>
      </div>
    </div>
  </div>
</footer>

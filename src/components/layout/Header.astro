---
import { site } from '../../data/site';
import Logo from '../brand/Logo.astro';
import Navigation from './Navigation.astro';
import MobileMenu from './MobileMenu.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---

<header data-header class="fixed inset-x-0 top-0 z-50" x-data="{ open: false }">
  <div class="container-nori flex h-16 items-center justify-between md:h-20">
    <Logo />

    <Navigation class="hidden lg:flex" />

    <div class="flex items-center gap-3">
      <Button href={`mailto:${site.email}`} size="sm" class="hidden sm:inline-flex">
        {site.hero.primaryCta}
        <Icon name="arrow-right" size={15} />
      </Button>
      <button
        type="button"
        class="inline-flex h-10 w-10 items-center justify-center rounded-full text-ink ring-1 ring-ink/10 transition-colors hover:bg-white lg:hidden"
        aria-label="Abrir menú"
        :aria-expanded="open.toString()"
        aria-controls="mobile-menu"
        @click="open = !open; document.body.classList.toggle('overflow-hidden', open)"
      >
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>

  <MobileMenu />
</header>

<style>
  [data-header] {
    background: transparent;
  }
</style>

<script>
  import { initHeader } from '../../scripts/header';

  initHeader();
</script>

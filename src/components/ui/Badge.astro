---
interface Props {
  class?: string;
  tone?: 'lavanda' | 'ink';
}

const { tone = 'lavanda', class: className } = Astro.props;

const tones = {
  lavanda: 'bg-lavanda/60 text-ink',
  ink: 'bg-ink text-cream',
} as const;
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full px-3 py-1 font-display text-xs font-semibold tracking-wide',
    tones[tone],
    className,
  ]}
>
  <slot />
</span>
